# GÖKAI V1 — Environment Configuration
# GÖK SYSTEMS TECH — Enterprise Autonomous AI Engineering Core

APP_NAME="GökAI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL="sqlite:///./gokai.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gokai"

# AI Model Provider API Keys (Configure your primary provider)
# Safe placeholders — enter your valid key or configure via Settings in Web UI
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# AI Model Routing Defaults
DEFAULT_PROVIDER="gemini"
DEFAULT_MODEL="gemini-2.5-flash"
FALLBACK_PROVIDER="openai"
FALLBACK_MODEL="gpt-4o-mini"

# Autonomy & Safety Limits
AUTONOMY_LEVEL="balanced" # "low", "balanced", "high"
MAX_AGENT_CALLS=50
MAX_DEBUG_CYCLES=5
MAX_TASK_COST_USD=2.0
MAX_DAILY_COST_USD=25.0

# Execution Sandbox Settings
SANDBOX_BACKEND="auto" # "docker", "local_process", "auto"
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_MEMORY_MB=2048

# Web UI
FRONTEND_PORT=3000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
